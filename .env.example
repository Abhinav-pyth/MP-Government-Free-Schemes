# Environment Variables
# Copy this file to .env and fill in your values
#
# IMPORTANT: For Vite, env variables MUST be prefixed with VITE_ to be exposed to the client.
# If you're using Next.js, use NEXT_PUBLIC_ prefix instead.

# Supabase Configuration (Vite)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Alternative for Next.js (if using Next.js instead of Vite)
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
